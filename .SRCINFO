pkgname = looking-glass
	pkgdesc = A client application for accessing the LookingGlass IVSHMEM device of a VM
	depends = binutils
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	depends = gmp
	depends = hicolor-icon-theme
	depends = libegl
